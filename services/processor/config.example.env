# API
NIXCLIP_HOST=0.0.0.0
NIXCLIP_PORT=8788
NIXCLIP_ALLOWED_ORIGINS=https://seu-frontend.example

# YouTube. O arquivo deve existir no host em ./secrets/youtube.cookies.txt.
NIXCLIP_YOUTUBE_COOKIE_FILE=/run/secrets/nixclip/youtube.cookies.txt
NIXCLIP_YOUTUBE_POT_PROVIDER_URL=http://pot-provider:4416

# mweb + provider PO é a combinação principal recomendada atualmente.
# web_embedded cobre somente vídeos incorporáveis; tv/android são fallbacks
# com restrições próprias de cookies/formatos.
NIXCLIP_YOUTUBE_PLAYER_CLIENTS=mweb,web_embedded,tv,android
NIXCLIP_YOUTUBE_DOWNLOAD_CONCURRENCY=1
NIXCLIP_YOUTUBE_DOWNLOAD_DELAY=15
NIXCLIP_YOUTUBE_SLEEP_REQUESTS=2
NIXCLIP_YOUTUBE_LIMIT_RATE=6000000
NIXCLIP_YOUTUBE_MAX_ATTEMPTS=6
NIXCLIP_YOUTUBE_BACKOFF_BASE=5
NIXCLIP_YOUTUBE_BACKOFF_CAP=120
NIXCLIP_YOUTUBE_RATE_LIMIT_COOLDOWN=600
